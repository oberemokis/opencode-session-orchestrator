{
  "name": "opencode-orchestrator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm run lint && pnpm run build && pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "vitest": "catalog:"
  }
}
