{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!.playwright-mcp", "!**/*.md"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 140
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["packages/opencode-orchestrator-runtime/src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "Ядро чистое: без ввода-вывода, часов и процессов."
                  },
                  {
                    "group": ["../*"],
                    "message": "Ядро не импортирует остальной runtime."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
